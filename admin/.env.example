# Full base URL of the Yatriko backend API, INCLUDING the /api/v1 suffix.
#
# Leave this empty in development: the Vite dev server (port 5174) proxies
# /api -> http://localhost:9005, and the app falls back to the relative
# path "/api/v1", so no CORS setup is needed.
#
# In production set it to the deployed API, e.g.
#   VITE_API_BASE_URL=https://api.yatrikogears.com/api/v1
VITE_API_BASE_URL=

# Origin of the public customer site, used by the "View public site" link.
# Defaults to http://localhost:5173 when empty.
VITE_PUBLIC_SITE_URL=
