{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "comment": "Point this at the admin Vercel deployment to keep the CMS on /admin. Replace the host, then redeploy.",
      "source": "/admin/:path*",
      "destination": "https://yatriko-admin.vercel.app/admin/:path*"
    },
    {
      "comment": "SPA fallback — must be last so real files and /admin win first.",
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
