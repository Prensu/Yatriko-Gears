# Base URL of the Express backend (see BACKEND_CONVENTIONS.md).
# In dev the Vite proxy forwards /api -> http://localhost:8000, so this can stay empty.
VITE_API_BASE_URL=

# Cloudinary cloud name for portfolio videos
VITE_CLOUDINARY_CLOUD_NAME=

# WhatsApp number for the floating chat button (no + sign)
VITE_WHATSAPP_NUMBER=9779747672039

# Google Sign-In client id (OAuth 2.0 Web application, console.cloud.google.com).
# Must be the SAME id as GOOGLE_CLIENT_ID in backend/.env.
# Leave blank to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
