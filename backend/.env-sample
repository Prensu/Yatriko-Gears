PORT=9005

DB_NAME=yatriko-gears
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

IMAGE_BASE_PATH=http://localhost:9005/images/

JWT_SECRET=<long-random-string>
JWT_REFRESH_SECRET=<another-long-random-string>

ALLOWED_ORIGINS=http://localhost:5173

SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<gmail-address>
SMTP_PASSWORD=<gmail-app-password>
FROM_ADDRESS=<gmail-address>
ADMIN_NOTIFY_EMAIL=<gmail-address-to-receive-booking-alerts>

# If deployed on Render Free Tier (which blocks outbound SMTP ports 25, 465, 587),
# set a Resend API key to send emails via HTTP API (port 443) without any port blocks:
RESEND_API_KEY=
RESEND_FROM=Yatriko Gears <noreply@your-verified-domain.com>

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

ADMIN_NAME=Yatriko Admin
ADMIN_EMAIL=admin@yatrikogears.com
ADMIN_PASSWORD=<strong-password>
ADMIN_PHONE=98XXXXXXXX


# --- Google Sign-In ---
# OAuth 2.0 Client ID (Web application) from console.cloud.google.com.
# Only the client id is needed — the browser gets an ID token and the server
# verifies its signature. Leave blank to hide the Google button entirely.
GOOGLE_CLIENT_ID=

# --- WhatsApp Business Cloud API (Meta) ---
# Leave all three blank to disable WhatsApp notifications (bookings still work).
# 1. Go to Meta for Developers → your app → WhatsApp → API Setup.
# 2. Copy the "Access Token" (use a permanent System User token for production).
# 3. Copy the numeric "Phone Number ID" (not the display phone number).
# 4. Create and get a Utility template approved in WhatsApp Manager; put its
#    exact name below (default: booking_confirmation).
#    Template variables (in order): {{1}} Name, {{2}} Code, {{3}} Gear summary,
#    {{4}} Dates, {{5}} Total.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=booking_confirmation
