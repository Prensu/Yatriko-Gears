# Copy to .env and fill in. Expo only exposes variables prefixed EXPO_PUBLIC_
# to the app, and inlines them at build time. Restart `pnpm start` after edits.
# Never put secrets here: everything in this file ships inside the app bundle.

# Backend origin WITHOUT /api/v1 (the app appends it).
# - Real phone on the same Wi-Fi as your PC: http://<your-PC-LAN-IP>:9005
# - Android emulator: http://10.0.2.2:9005
# - iOS simulator: http://localhost:9005
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:9005

# WhatsApp number in international format, digits only (no + or spaces).
EXPO_PUBLIC_WHATSAPP_NUMBER=

# Optional: shown on the Contact screen as a call button.
EXPO_PUBLIC_SUPPORT_PHONE=

# Optional: Google sign-in. Leave blank to hide the button.
# Use the SAME *Web* OAuth client id as backend GOOGLE_CLIENT_ID, otherwise
# the backend rejects the token (it checks the audience).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only, build-time: reversed iOS client id, e.g. com.googleusercontent.apps.1234-abcd
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# App identity (change before the first store build; they cannot change later).
EXPO_PUBLIC_ANDROID_PACKAGE=np.com.yatrikogears.app
EXPO_PUBLIC_IOS_BUNDLE_ID=np.com.yatrikogears.app
